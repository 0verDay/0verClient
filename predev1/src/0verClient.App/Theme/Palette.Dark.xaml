<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============ 深色主题调色板 ============
        这里只放颜色，不放任何 Style / Template —— 样式统一在 Theme/Theme.xaml 里，
        并且全部用 DynamicResource 引用本文件里的键。

        这样做的理由：换主题时只需要把本文件从 Application.Resources 的合并字典里
        换掉（见 Theme/ThemeManager.cs），所有 DynamicResource 会立刻重新求值，
        界面实时跟着变色，不需要重建窗口。

        命名规则：Theme* = 主题相关的表面/文字；Accent* / Danger / Success / Warning
        是跨主题共享的语义色，两个调色板里的值保持一致。

        注意：本文件里的画刷刻意不写 PresentationOptions:Freeze="True"。
        GameCardButton 模板会对 Background.Color 做动画（见 Theme.xaml）。
    -->

    <!-- ===== 主题相关颜色 ===== -->
    <Color x:Key="WindowBgColor">#E6121419</Color>
    <Color x:Key="WindowBorderColor">#26FFFFFF</Color>

    <SolidColorBrush x:Key="WindowBg" Color="{StaticResource WindowBgColor}" />
    <SolidColorBrush x:Key="WindowBorder" Color="{StaticResource WindowBorderColor}" />
    <SolidColorBrush x:Key="SidebarBg" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="CardBgHover" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="HairLine" Color="#1AFFFFFF" />

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9AA3B2" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF6B7280" />

    <!-- 覆盖在窗口底色上的微亮/微暗层（幽灵按钮、输入框、复选框、进度条轨道） -->
    <SolidColorBrush x:Key="ControlBg" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="ControlBgHover" Color="#2AFFFFFF" />

    <!-- 侧边栏导航项 -->
    <SolidColorBrush x:Key="NavHoverBg" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="NavSelectedBg" Color="#1FFFFFFF" />

    <!-- 标题栏按钮 -->
    <SolidColorBrush x:Key="CaptionHoverBg" Color="#22FFFFFF" />

    <!-- 游戏卡片里的动作胶囊、封面首字母水印 -->
    <SolidColorBrush x:Key="ActionPillBg" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="CoverWatermark" Color="#4DFFFFFF" />

    <!-- 进度条轨道 -->
    <SolidColorBrush x:Key="TrackBg" Color="#22FFFFFF" />

    <!-- 启动器更新横幅 -->
    <SolidColorBrush x:Key="UpdateBannerBg" Color="#244C8DFF" />
    <SolidColorBrush x:Key="UpdateBannerBorder" Color="#4D4C8DFF" />

    <!-- 空状态图标底、底部状态栏 -->
    <SolidColorBrush x:Key="EmptyIconBg" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="StatusBarBg" Color="#0AFFFFFF" />

    <!-- ===== 跨主题共享的语义色 ===== -->
    <Color x:Key="AccentColor">#FF4C8DFF</Color>
    <Color x:Key="AccentSoftColor">#FF7FB0FF</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF26D6D" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF5CD68A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC14D" />
    <SolidColorBrush x:Key="CloseHoverBg" Color="#E81123" />

</ResourceDictionary>

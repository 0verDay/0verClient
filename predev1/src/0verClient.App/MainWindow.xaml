<Window x:Class="OverClient.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OverClient.App.ViewModels"
        Title="0verClient"
        Width="1180" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <Window.Resources>

        <!-- 游戏卡片模板：游戏库与下载页共用，保证两处永远长得一样 -->
        <DataTemplate x:Key="GameCardTemplate" DataType="{x:Type vm:GameCardViewModel}">
            <Button Style="{StaticResource GameCardButton}"
                    Command="{Binding ActionCommand}"
                    Width="230" Height="300" Margin="0,0,14,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="126" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="13,13,0,0" Background="{Binding CoverBrush}">
                        <TextBlock Text="{Binding Initial}"
                                   FontSize="52" FontWeight="Bold" Foreground="{DynamicResource CoverWatermark}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                   Margin="0,0,14,-6" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="14,12,14,0">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TagText}" FontSize="11" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Summary}" FontSize="11.5" Margin="0,8,0,0" MaxHeight="32"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="14,0,14,14">
                        <!--
                            Mode=OneWay 不能删。
                            RangeBase.Value（ProgressBar.Value 的基类）元数据里是 BindsTwoWayByDefault，
                            不写 Mode 就会按 TwoWay 绑定；而 Progress 是只读属性（私有 setter），
                            于是每实例化一张卡片就抛一次 XamlParseException —— 这个错误编译期完全看不出来。
                        -->
                        <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100"
                                     Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,10"
                                     Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="12"
                                           Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DetailText}" FontSize="10.5" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="{DynamicResource ActionPillBg}" CornerRadius="7"
                                    Padding="11,5" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding ActionText}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

    </Window.Resources>

    <!-- 半透明圆角外壳 -->
    <Border Background="{DynamicResource WindowBg}" CornerRadius="14"
            BorderBrush="{DynamicResource WindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== 顶部栏 ===== -->
            <Grid Grid.Row="0" Background="Transparent"
                  MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="6" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="0" FontSize="12" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="0verClient" FontSize="14.5" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock Text="0verDay 游戏启动器" FontSize="11.5" Margin="10,1,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button Style="{StaticResource CaptionButton}" Content="—" Click="Minimize_Click" />
                    <Button Style="{StaticResource CloseButton}" Content="✕" Click="Close_Click" Margin="4,0,0,0" />
                </StackPanel>
            </Grid>

            <!-- ===== 主体 ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="198" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 左侧边栏 -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBg}" CornerRadius="12,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="18,0,18,18">
                            <Border Height="1" Background="{DynamicResource HairLine}" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding LauncherVersion, StringFormat=版本 {0}}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Text="{Binding Channel, StringFormat=通道 {0}}"
                                       FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource TextMuted}" />
                        </StackPanel>

                        <ListBox Style="{StaticResource NavList}"
                                 Margin="12,12,12,0"
                                 SelectedIndex="{Binding NavIndex, Mode=TwoWay}">
                            <ListBoxItem Content="游戏库" />
                            <ListBoxItem Content="下载" />
                            <ListBoxItem Content="设置" />
                        </ListBox>
                    </DockPanel>
                </Border>

                <!-- 右侧内容区 -->
                <Grid Grid.Column="1" Margin="22,6,22,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding PageTitle}" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="{Binding PageSubtitle}" FontSize="12" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- 刷新按钮必须常驻：之前只在空库时才出现，导致"保存后不知道怎么刷新" -->
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="刷新游戏库"
                                Height="30" Padding="14,0" VerticalAlignment="Top" Margin="12,2,0,0"
                                Command="{Binding RefreshCommand}"
                                Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!--
                        ===== 启动器更新横幅 =====
                        只有内容源在站点根下提供了 latest.json 且版本比本机新时才出现。
                        IsLauncherUpdateAvailable 是只读属性，走 BoolToVis 转换器（不是直接绑 Visibility）。
                        IsEnabled 显式绑 CanApplyLauncherUpdate：站点没给 sha256 时按钮必须是灰的。
                    -->
                    <Border Grid.Row="1" Margin="0,0,0,14" Padding="14,10" CornerRadius="9"
                            Background="{DynamicResource UpdateBannerBg}" BorderBrush="{DynamicResource UpdateBannerBorder}" BorderThickness="1"
                            Visibility="{Binding IsLauncherUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="启动器更新" FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock Text="{Binding LauncherUpdateText}" FontSize="11.5" Margin="0,4,0,0"
                                           TextWrapping="Wrap" LineHeight="17"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>

                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                    Content="{Binding LauncherUpdateActionText}"
                                    Command="{Binding UpdateLauncherCommand}"
                                    IsEnabled="{Binding CanApplyLauncherUpdate}"
                                    Height="30" Padding="14,0"
                                    VerticalAlignment="Center" Margin="14,0,0,0" />
                        </Grid>
                    </Border>

                    <!-- 游戏库 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsLibraryVisible, Converter={StaticResource BoolToVis}}">
                        <!--
                            左上这 8px 留白不是装饰，是必需的，别删：
                            卡片悬停时 Halo 绕中心放大到 1.022，会向外溢出按钮边界
                            （横向 2.5px、纵向 3.3px），而卡片自身的 Margin 只有右下各 14px。
                            内容若从 ScrollViewer 的 (0,0) 开始，第一列/第一行的描边就会被视口裁掉
                            左边和上边 —— 表现就是"最左上角那张卡的描边框缺两条边"。
                        -->
                        <ItemsControl Margin="8,8,0,0"
                                      ItemsSource="{Binding Games}" ItemTemplate="{StaticResource GameCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 下载 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsDownloadsVisible, Converter={StaticResource BoolToVis}}">
                        <ItemsControl Margin="8,8,0,0"
                                      ItemsSource="{Binding Downloads}" ItemTemplate="{StaticResource GameCardTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- 设置 -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding IsSettingsVisible, Converter={StaticResource BoolToVis}}">
                        <!--
                            Width 必须是固定值，不能写 MaxWidth。
                            ScrollViewer 的内容在水平方向按"无限宽"测量，于是 StackPanel 会去
                            量它最宽的那个子元素（长段落文字），量完再被 MaxWidth 砍到 640。
                            结果 StackPanel 的实际宽度**永远等于 640**，它里面任何
                            HorizontalAlignment 没写 Left 的子元素都会被居中 —— 主题下拉框
                            当时就是这么飘到中间的。固定 Width=640 让宽度与测量无关，
                            这类问题不会再出现。
                        -->
                        <StackPanel Width="640" HorizontalAlignment="Left">

                            <!-- ===== 界面主题 ===== -->
                            <TextBlock Text="界面主题" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="选择深色或浅色外观。选完立刻生效，并记进 settings.json，下次启动沿用。"
                                       FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />

                            <!--
                                SelectedValue + SelectedValuePath 配 SelectedTheme（字符串属性）：
                                ComboBox 的 SelectedItem/SelectedValue 默认就是 TwoWay，
                                这里绑的是**可写**属性，所以不需要（也不能）写 Mode=OneWay。
                                （对比卡片里的 ProgressBar.Value —— 那是只读属性，必须显式 OneWay。）

                                用 ItemTemplate 而不是 DisplayMemberPath：自研的 ComboBoxItem /
                                闭合态模板都不认 DisplayMemberPath，会退化成显示 record 的 ToString()。
                            -->
                            <!--
                                必须显式写 HorizontalAlignment="Left"。
                                ComboBox 在样式里设了固定 Width=168，而**固定宽度**的元素在 StackPanel
                                里的默认对齐是居中，不是靠左（默认 HorizontalAlignment=Stretch 只在
                                宽度没被写死时才表现为靠左）。不写这行，选框就会飘到 640 宽容器的中间。
                            -->
                            <ComboBox Style="{StaticResource ThemedComboBox}" Margin="0,8,0,0"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding ThemeOptions}"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding SelectedTheme}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="{Binding ThemeHint}" />

                            <Border Height="1" Background="{DynamicResource HairLine}" Margin="0,22,0,18" />

                            <TextBlock Text="内容源索引地址" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Text="启动器启动时拉取这个 index.json，所有游戏信息都从它推导，客户端不内置任何游戏。"
                                       FontSize="11.5" Margin="0,5,0,8" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Style="{StaticResource UrlBox}"
                                         Text="{Binding IndexUrl, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="保存"
                                        Command="{Binding SaveSettingsCommand}" Margin="10,0,0,0" />
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="刷新游戏库"
                                        Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                            </Grid>

                            <TextBlock Text="允许的主机白名单（逗号分隔；留空表示不限制 https 主机）"
                                       FontSize="11.5" Margin="0,14,0,6"
                                       Foreground="{DynamicResource TextMuted}" />
                            <TextBox Style="{StaticResource UrlBox}"
                                     Text="{Binding AllowedHosts, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Style="{StaticResource DarkCheck}" Margin="0,12,0,0"
                                      IsChecked="{Binding AllowInsecureHttp}"
                                      Content="允许明文 http（仅调试用；主机仍必须在上面的白名单里）" />

                            <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="{Binding PolicyHint, StringFormat=当前生效策略：{0}}" />

                            <TextBlock FontSize="11.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="说明：https 是本启动器的默认要求。明文 http 需要同时满足两个条件才会被放行 —— 打开上面的开关，且把主机写进白名单。这样上线时不会因为一个开关就把所有主机都放开。" />

                            <Border Height="1" Background="{DynamicResource HairLine}" Margin="0,22,0,18" />

                            <TextBlock Text="运行信息" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="数据目录" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DataRoot}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7" />
                                <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开"
                                        Height="28" Padding="12,0" Margin="10,0,0,7"
                                        Command="{Binding OpenDataFolderCommand}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="游戏目录" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,7" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GamesRoot}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,7" />
                                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource GhostButton}" Content="打开"
                                        Height="28" Padding="12,0" Margin="10,0,0,7"
                                        Command="{Binding OpenGamesFolderCommand}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="日志" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LogsRoot}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <Border Height="1" Background="{DynamicResource HairLine}" Margin="0,22,0,18" />

                            <TextBlock Text="断点续传验证" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="用 DevServer 的 --drop-after 参数可以让服务器在传输中途掐断连接。重新点击安装，客户端会从 .part 文件已有的字节数继续，而不是从头下载。" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 空库状态：只留一句状态栏小字太容易让人以为是"没有安装按钮"这个 bug -->
                    <StackPanel Grid.Row="2" MaxWidth="580" VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Visibility="{Binding ShowLibraryEmptyState, Converter={StaticResource BoolToVis}}">
                        <Border Width="46" Height="46" CornerRadius="14" Background="{DynamicResource EmptyIconBg}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="!" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding EmptyStateTitle}" FontSize="16" FontWeight="SemiBold"
                                   Margin="0,14,0,0" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock Text="{Binding EmptyStateDetail}" FontSize="12" Margin="0,10,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                                   Foreground="{DynamicResource TextMuted}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="重试" Width="110"
                                Command="{Binding RefreshCommand}" Margin="0,18,0,0"
                                HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ===== 状态栏 ===== -->
            <Border Grid.Row="2" Background="{DynamicResource StatusBarBg}" CornerRadius="0,0,14,14" Padding="20,8">
                <TextBlock Text="{Binding StatusText}" FontSize="11.5"
                           Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Border>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<!--
  0verClient 刻意保持零 NuGet 依赖：普通的 `dotnet build` 不需要任何包，
  所以不带 `-Aot` / `-Trimmed` / `-SelfContained` 时它完全不联网。

  ⚠️ 但 nuget.org 必须留在源列表里。

  这里原本是 <clear />（一个源都不留），当时的想法是"保证 restore 永远离线可完成"。
  结果是：NativeAOT 发布需要 ILCompiler / ILLink / Runtime.* 这些包，而 restore
  会在 **0.6 秒内**以 NU1100 失败 —— 快得看不出是"没配源"，很容易误判成网络问题。
  踩过这个坑，所以保留官方源。

  另外注意：即使配了源，零 PackageReference 的项目也不会去访问它。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
